    },
    {
      "_id": "tc-21", "colId": "nutriapp-blackbox-2026", "containerId": "f-ai-llm",
      "name": "TC-21 · Recomendación nutricional completa con SMAE",
      "method": "POST", "url": "{{baseUrl}}/api/ai/recommendation", "sortNum": 21,
      "headers": [
        { "name": "Authorization", "value": "Bearer {{token}}" },
        { "name": "Content-Type",  "value": "application/json" }
      ],
      "body": { "type": "json", "raw": "{\"name\":\"Ana López\",\"age\":35,\"gender\":\"F\",\"weight\":65,\"height\":162,\"objective\":\"Pérdida de peso\"}" },
      "tests": [
        { "type": "res-status", "action": "equal", "value": "200" },
        { "type": "res-body", "action": "contains", "value": "SMAE" }
      ]
    },
    {
      "_id": "tc-22", "colId": "nutriapp-blackbox-2026", "containerId": "f-ai-llm",
      "name": "TC-22 · Análisis de alimento SMAE — Tortilla de maíz",
